{
  "name": "grand-line-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:fetch": "tsx scripts/fetch-wiki.ts",
    "data:build": "tsx scripts/build-arcs.ts && tsx scripts/build-locations.ts && tsx scripts/auto-layout.ts && tsx scripts/build-crew.ts && tsx scripts/build-route.ts && tsx scripts/check-summaries.ts",
    "data:layout": "tsx scripts/auto-layout.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "size": "tsx scripts/check-size.ts",
    "capture": "npm run build && tsx scripts/capture.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@tsparticles/basic": "^4.4.0",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/shape-star": "^4.4.0",
    "framer-motion": "^13.5.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wtf_wikipedia": "^10.4.2",
    "zod": "^4.6.5"
  }
}
